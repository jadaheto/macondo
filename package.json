{
  "name": "macondo-digital",
  "private": true,
  "version": "0.1.0",
  "description": "Biblioteca escolar interactiva — Biblioteca Macondo, Comfasucre",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d db",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "build:shared": "npm run build -w @macondo/shared",
    "dev:api": "npm run dev -w @macondo/api",
    "dev:web": "npm run dev -w @macondo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.21.5": true,
    "@swc/core@1.16.21": true,
    "fsevents@2.3.3": true,
    "core-js": false,
    "es5-ext": false
  }
}
