{
  "name": "@macondo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev -p 3100 -H 0.0.0.0",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "start": "next start -p ${PORT:-3100} -H 0.0.0.0",
