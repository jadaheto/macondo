<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Macondo" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_cyan</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:navigationBarColor">@color/brand_primary_dark</item>
        <item name="android:textColorPrimary">@color/brand_text</item>
        <item name="android:textColorSecondary">@color/brand_muted</item>
    </style>

    <!-- Pantalla de arranque: fondo blanco con el logotipo centrado mientras carga la web. -->
    <style name="Theme.Macondo.Splash">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <style name="Theme.Macondo.Settings" parent="Theme.Macondo">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>
</resources>
