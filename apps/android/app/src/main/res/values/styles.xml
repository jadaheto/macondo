<?xml version="1.0" encoding="utf-8"?>
<!-- Estilos de la pantalla Configuración según el perfil kiosco (branding.md §3.4, §5, §6):
     controles mínimo 56dp, radio 12dp, títulos 26sp aprox. -->
<resources>
    <style name="Macondo.SectionTitle" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Macondo.Help" parent="android:Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/brand_muted</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Macondo.Input" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:textColor">@color/brand_text</item>
        <item name="android:textColorHint">@color/brand_muted</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>
    <style name="Macondo.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">@color/brand_text</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Macondo.Radio" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textColor">@color/brand_text</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Macondo.ButtonPrimary" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/button_primary_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Macondo.ButtonSecondary" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/button_secondary_bg</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
