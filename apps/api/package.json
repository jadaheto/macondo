{
  "name": "@macondo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prisma": "node scripts/prisma.cjs",
    "prisma:generate": "node scripts/prisma.cjs generate",
    "prisma:migrate": "node scripts/prisma.cjs migrate dev",
    "db:deploy": "node scripts/prisma.cjs migrate deploy",
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@macondo/shared": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "@swc/core": "^1.10.0",
    "vitest": "^2.1.8"
  }
}
