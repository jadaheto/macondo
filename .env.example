# ─────────────────────────────────────────────────────────────────────────────
# Macondo Digital — variables de entorno
# Local: copiar a .env en la raíz. EasyPanel: pegar en la pestaña "Environment"
# de cada servicio (ver docs/DEPLOY-EASYPANEL.md).
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────────────────
# Local (docker compose de infra/docker, puerto host 5544):
DATABASE_URL=postgresql://macondo:macondo_dev@localhost:5544/macondo?schema=public
# EasyPanel: usar la "Internal Connection URL" del servicio Postgres, p. ej.
# DATABASE_URL=postgresql://postgres:CLAVE@<proyecto>_macondo-db:5432/macondo?schema=public

# ── API (NestJS) ─────────────────────────────────────────────────────────────
API_PORT=4100
# Mínimo 32 caracteres. En producción: generar con `openssl rand -base64 48`.
JWT_SECRET=cambia-esto-en-produccion-minimo-32-caracteres
STORAGE_DRIVER=local
# Relativo a apps/api, o absoluto (en Docker/EasyPanel: /app/storage con volumen).
STORAGE_DIR=../../storage
MAX_UPLOAD_MB=200

# ── Acceso desde varias IP (DESARROLLO) ──────────────────────────────────────
# "*" = acepta cualquier origen/IP (tablets, kiosco, TV y PCs de la red).
# PRODUCCIÓN (dominio registrado: macondo.comfasucre.co) — valores a usar en EasyPanel:
#   CORS_ORIGIN=https://macondo.comfasucre.co
#   PUBLIC_ORIGIN=https://macondo.comfasucre.co   (origen de los QR de kiosco/TV; opcional)
#   SEED_ON_START=false  y  JWT_SECRET / contraseñas nuevas
CORS_ORIGIN=*
# Origen público para los códigos QR (vacío = el origen con el que se abre la página).
PUBLIC_ORIGIN=
# Orígenes permitidos para `next dev` (patrones por segmento). No afecta a producción.
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,192.168.*.*,10.*.*.*,172.*.*.*,*.local

# ── Web (Next.js) ────────────────────────────────────────────────────────────
WEB_PORT=3100
# URL INTERNA de la API vista desde el contenedor web. Se usa en el build (rewrites)
# y en ejecución. Local: http://localhost:4100 · EasyPanel: http://<proyecto>_macondo-api:4100
API_INTERNAL_URL=http://localhost:4100

# ── Seed (solo desarrollo / primera instalación) ─────────────────────────────
# SEED_ON_START=true ejecuta el seed idempotente al arrancar la API (contenedor).
SEED_ON_START=false
SEED_ADMIN_EMAIL=admin@macondo.local
SEED_ADMIN_PASSWORD=MacondoDev2026!
SEED_LIBRARIAN_EMAIL=bibliotecaria@macondo.local
SEED_LIBRARIAN_PASSWORD=BibliotecaDemo2026!

# ── HTTPS local opcional (tablets Fire HD 10 / APK) ──────────────────────────
# Perfil `https` de docker-compose.yml: `docker compose --profile https up -d macondo-https`.
# Certificados con `sh scripts/make-local-certs.sh` (CA local en infra/certs).
PUBLIC_HTTPS_PORT=3443
# IP fija del servidor en la red de la biblioteca (la que lleva el certificado y la APK).
LAN_HOST=192.168.31.240

# Narración sintética (ADR-017). Las imágenes Docker ya traen Piper + voz y fijan estas variables;
# en desarrollo local sin Piper la API responde 503 «Narración no disponible» (no bloquea nada).
# TTS_ENABLED=true
# TTS_ENGINE=piper
# TTS_PIPER_BIN=/opt/piper-venv/bin/piper          # host: ~/piper-venv/bin/piper (pip install piper-tts==1.8.0)
# TTS_VOICE=/opt/piper/voices/es_ES-davefx-medium.onnx   # el .onnx.json debe estar al lado
# TTS_MP3_BIN=                                      # vacío = buscar lame y luego ffmpeg en PATH
# TTS_TIMEOUT_MS=600000
# TTS_MAX_PARALLEL=2

# ── Taller de cuentos (ADR-018) ──────────────────────────────────────────────
# Proveedor de IA (DeepSeek, Chat Completions compatible con OpenAI). Vacío = «modo plantilla» (sin internet).
# La clave NUNCA se registra ni llega al navegador. Al proveedor solo van opciones cerradas y el nombre del protagonista.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# CUENTOS_ENABLED=true
# Bandas que ven el taller (separadas por coma).
CUENTOS_BANDAS=1-3,4-5
# Cuentos por dispositivo y hora (hash de un id aleatorio; sin IP) y tope global por hora.
CUENTOS_LIMITE_POR_HORA=3
CUENTOS_LIMITE_GLOBAL_POR_HORA=60
# CUENTOS_TIMEOUT_MS=60000     # tiempo máximo por petición al proveedor
# CUENTOS_AUDIO=true           # narrar el cuento con la voz de la biblioteca (ADR-017) si el motor está disponible
